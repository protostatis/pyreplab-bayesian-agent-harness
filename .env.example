# Example SSH alias for a disposable Linux sandbox host.
PYREPLAB_HARNESS_HOST=ubuntu-local

# These must be absolute paths on the remote host.
PYREPLAB_REMOTE_PROJECT=/absolute/path/to/pyreplab-bayesian-agent-harness
PYREPLAB_REMOTE_RUN_ROOT=/absolute/path/to/pyreplab-bayesian-agent-harness/.runs

# Pi provider/model names configured on the controller machine.
PYREPLAB_PI_PROVIDER=your-provider
PYREPLAB_PI_MODEL=your-model
PYREPLAB_PI_THINKING=off
PYREPLAB_PI=pi

# Optional fixed-page Unbrowser smoke binary on the disposable remote host.
PYREPLAB_REMOTE_UNBROWSER=/usr/local/bin/unbrowser

# Optional. Leave empty unless your Pi provider requires a switch extension.
PYREPLAB_MODEL_SWITCH_EXTENSION=
